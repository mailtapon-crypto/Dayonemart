<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 
        Copy this file to secrets.xml and fill in your real values.
        
        IMPORTANT: secrets.xml is gitignored and should never be committed!
    -->
    
    <!-- Get your Google Maps API key from: https://console.cloud.google.com/apis/credentials -->
    <string name="google_maps_api_key">YOUR_GOOGLE_MAPS_API_KEY</string>
    
    <!-- Get your Facebook credentials from: https://developers.facebook.com/apps -->
    <string name="facebook_app_id">YOUR_FACEBOOK_APP_ID</string>
    <string name="fb_login_protocol_scheme">fbYOUR_FACEBOOK_APP_ID</string>
    <string name="facebook_client_token">YOUR_FACEBOOK_CLIENT_TOKEN</string>
</resources>
